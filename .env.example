# Admin Panel "owner" login — used for the very first login on a fresh
# database, before any admin user exists in the database. Change these
# before deploying publicly.
ADMIN_EMAIL=adnanravendigimark@gmail.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING

# Neon Postgres — create a free project at https://neon.tech, then copy the
# "Pooled connection" string from Connection Details.
# IMPORTANT: use a NEW Neon project for this app — do not reuse the
# DATABASE_URL from any of your other repos, or the two apps will read and
# write the same tables.
DATABASE_URL=

# Session cookie signing secret — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# Vercel Blob — used for every image upload (contributor article images,
# admin city hero images). Vercel dashboard → Storage → Blob → create a
# store → copy the token, or run `vercel blob store add`.
# IMPORTANT: use a NEW Blob store for this app — do not reuse the token
# from any of your other repos.
BLOB_READ_WRITE_TOKEN=

# This app's own base URL — used to build the Google OAuth redirect URI and
# the links inside password-reset and email-verification emails. Set to
# your local dev URL while developing and your real production URL once
# deployed (no trailing slash).
APP_URL=http://localhost:3000

# Google Sign-In (OAuth 2.0 / OIDC) — optional. Without these two set, the
# "Continue with Google" button on /login and /signup shows a clear error
# instead of a broken redirect; email/password signup and login work either
# way.
#   1. https://console.cloud.google.com/apis/credentials -> Create Credentials
#      -> OAuth client ID -> Application type: "Web application".
#   2. Add an Authorized redirect URI of exactly:
#        {APP_URL}/api/auth/google/callback
#      for both your local dev APP_URL and your production APP_URL.
#   3. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com) — optional, used to actually email welcome/
# password-reset/article workflow notifications (submitted, approved,
# rejected, published, etc.). Without this set, emails are logged to the
# server console instead (and reset links are echoed back in the API
# response, but only outside production) — fine for local development, not
# for a real launch.
RESEND_API_KEY=

# Who workflow emails are sent "from". Resend requires the domain in this
# address to be verified in your Resend account (Domains -> Add Domain,
# then add the DNS records it gives you) — sending "from" an unverified
# domain gets rejected with a 403. Leave this unset and it defaults to:
#   World Attraction News <info@worldattractionnews.com>
# Override here if you need a different sender for a given environment.
RESEND_FROM_EMAIL=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox —
# https://www.google.com/recaptcha/admin) — optional bot/abuse protection
# on the /signup, /login, AND /admin/login forms, on top of the existing
# per-IP rate limiting. Without these two set, the widget simply doesn't
# render and no verification is required — same "gracefully absent until
# configured" behavior as Google Sign-In above.
#   1. https://www.google.com/recaptcha/admin/create -> register a new
#      site, type "reCAPTCHA v2" -> "\"I'm not a robot\" Checkbox".
#   2. Domains: your APP_URL's hostname (e.g. localhost for local dev, or
#      your real domain in production — you can register multiple
#      hostnames on one site).
#   3. Copy the Site Key (safe to expose to the browser) and Secret Key
#      (server-only, never expose this one) below.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cron secret — protects /api/cron/publish-scheduled, the endpoint that
# publishes scheduled articles automatically. Set this to any long random
# string, then add the same value in Vercel's Cron settings (or as a Bearer
# token if triggering it another way). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional, but recommended before deploying publicly — without it, the
# endpoint has no auth check (it can still only publish articles an admin
# already scheduled, so this is a low-severity gap, not a data risk).
CRON_SECRET=
